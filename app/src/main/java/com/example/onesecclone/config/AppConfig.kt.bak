package com.example.onesecclone.config

import android.content.Context
import com.example.onesecclone.BuildConfig

/**
 * Central configuration class for managing app settings
 * This allows easy management of server URLs and other configuration
 * 
 * ⚠️ IMPORTANT: To change server IP, only modify SERVER_IP below!
 */
object AppConfig {

    // 🔥 SINGLE SOURCE OF TRUTH - Change IP here only!
    private const val SERVER_IP = "192.168.1.100"
    private const val SERVER_PORT = "8080"
    private const val SERVER_PROTOCOL = "http"
    
    // Auto-generated URLs from central IP (DO NOT MODIFY THESE)
    private val BASE_SERVER_URL = "$SERVER_PROTOCOL://$SERVER_IP:$SERVER_PORT/"
    
    const val DEFAULT_PRODUCTION_URL = BASE_SERVER_URL
    const val DEFAULT_STAGING_URL = BASE_SERVER_URL  
    const val DEFAULT_LOCAL_URL = BASE_SERVER_URL

    // Environment variable names (can be set via build configuration)
    const val ENV_SERVER_URL = "SERVER_URL"
    const val ENV_API_KEY = "API_KEY"
    
    // Public accessors for other components
    fun getServerIp(): String = SERVER_IP
    fun getServerPort(): String = SERVER_PORT
    fun getServerProtocol(): String = SERVER_PROTOCOL
    fun getBaseServerUrl(): String = BASE_SERVER_URL

    /**
     * Gets the appropriate server URL based on build type and configuration
     */
    fun getServerUrl(context: Context): String {
        // Always use the centralized BASE_SERVER_URL
        // This ensures consistency across all builds
        return BASE_SERVER_URL
    }

    /**
     * Get build config string value safely
     */
    private fun getBuildConfigString(fieldName: String): String? {
        return try {
            val buildConfigClass = Class.forName("com.example.onesecclone.BuildConfig")
            val field = buildConfigClass.getDeclaredField(fieldName)
            field.get(null) as? String
        } catch (e: Exception) {
            null
        }
    }

    /**
     * Server environment options for easy switching
     */
    enum class ServerEnvironment(val displayName: String, val url: String) {
        PRODUCTION("Production Server", DEFAULT_PRODUCTION_URL),
        STAGING("Staging Server", DEFAULT_STAGING_URL),
        LOCAL("Local Development", DEFAULT_LOCAL_URL),
        CUSTOM("Custom URL", "")
    }
}
